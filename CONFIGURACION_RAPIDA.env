# 🔧 CONFIGURACIÓN RÁPIDA - PEQUEFEST.COM
# Edita este archivo con tus datos reales

# ==========================================
# 📧 CONFIGURACIÓN DE EMAIL
# ==========================================

# 1. Ve a https://www.emailjs.com/
# 2. Registrate gratis (300 emails/mes)
# 3. Crea un servicio de email
# 4. Crea 2 plantillas: una para clientes, otra para ti
# 5. Reemplaza estos valores:

EMAIL_SERVICE_ID=service_xxxxxxx
EMAIL_PUBLIC_KEY=pk_xxxxxxx
EMAIL_CUSTOMER_TEMPLATE=template_xxxxxxx
EMAIL_OWNER_TEMPLATE=template_xxxxxxx
EMAIL_ENABLED=false  # Cambiar a true cuando esté configurado

# ==========================================
# 📱 CONFIGURACIÓN DE TELEGRAM
# ==========================================

# 1. Busca @BotFather en Telegram
# 2. Envía: /newbot
# 3. Nombre: "Pequefest Notificaciones"
# 4. Username: "pequefest_bot"
# 5. Copia el TOKEN que te da
# 6. Busca @userinfobot y envía cualquier mensaje para obtener tu Chat ID
# 7. Reemplaza estos valores:

TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE
TELEGRAM_ENABLED=false  # Cambiar a true cuando esté configurado

# ==========================================
# 🏢 TUS DATOS DE NEGOCIO
# ==========================================

BUSINESS_NAME=Pequefest.com
BUSINESS_EMAIL=oscarlarroy@gmail.com  # ✅ Ya configurado con tu email
BUSINESS_PHONE=+34 XXX XXX XXX        # ❗ ACTUALIZAR con tu teléfono
BUSINESS_ADDRESS=Madrid, España

# ==========================================
# 🧪 MODO DE PRUEBAS
# ==========================================

# Mantén en true hasta que todo esté configurado
TESTING_MODE=true
SIMULATE_NOTIFICATIONS=true

